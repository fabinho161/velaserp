rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userCompanyPath(uid, empresaId) {
      return /databases/$(database)/documents/users/$(uid)/empresas/$(empresaId);
    }

    function authCompanyPath(uid, empresaId) {
      return /databases/$(database)/documents/usuariosPorAuth/$(uid)/empresas/$(empresaId);
    }

    function companyUserPath(ownerUid, empresaId, usuarioEmpresaId) {
      return /databases/$(database)/documents/users/$(ownerUid)/empresas/$(empresaId)/usuariosEmpresa/$(usuarioEmpresaId);
    }

    function invitePath(token) {
      return /databases/$(database)/documents/convitesEmpresa/$(token);
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminMaster() {
      return signedIn() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.role == "admin_master";
    }

    function isOwnCompanyDocument(userId) {
      return !request.resource.data.keys().hasAny(["ownerUid"]) ||
        request.resource.data.ownerUid == userId;
    }

    function isExistingOwnCompanyDocument(userId) {
      return !resource.data.keys().hasAny(["ownerUid"]) ||
        resource.data.ownerUid == userId;
    }

    function isSafeCompanyPointerUpdate(userId) {
      return isOwner(userId) &&
        resource.data.keys().hasAny(["ownerUid"]) &&
        resource.data.ownerUid != userId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.conviteToken == resource.data.conviteToken &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status;
    }

    function hasValidCompanyLink(linkPath, ownerUid, empresaId) {
      return signedIn() &&
        exists(linkPath) &&
        get(linkPath).data.ownerUid == ownerUid &&
        get(linkPath).data.status == "ativo" &&
        get(linkPath).data.usuarioEmpresaId is string &&
        exists(companyUserPath(
          ownerUid,
          empresaId,
          get(linkPath).data.usuarioEmpresaId
        )) &&
        get(companyUserPath(
          ownerUid,
          empresaId,
          get(linkPath).data.usuarioEmpresaId
        )).data.uidAuth == request.auth.uid &&
        get(companyUserPath(
          ownerUid,
          empresaId,
          get(linkPath).data.usuarioEmpresaId
        )).data.status == "ativo" &&
        get(companyUserPath(
          ownerUid,
          empresaId,
          get(linkPath).data.usuarioEmpresaId
        )).data.convitePendente == false;
    }

    function hasActiveCompanyMembership(ownerUid, empresaId) {
      return hasValidCompanyLink(authCompanyPath(request.auth.uid, empresaId), ownerUid, empresaId) ||
        hasValidCompanyLink(userCompanyPath(request.auth.uid, empresaId), ownerUid, empresaId);
    }

    function hasCompanyAdminLink(linkPath, ownerUid, empresaId) {
      return hasValidCompanyLink(linkPath, ownerUid, empresaId) &&
        (
          get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.role == "administrador_empresa" ||
          get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.perfil == "administrador_empresa"
        );
    }

    function hasCompanyAdminMembership(ownerUid, empresaId) {
      return hasCompanyAdminLink(authCompanyPath(request.auth.uid, empresaId), ownerUid, empresaId) ||
        hasCompanyAdminLink(userCompanyPath(request.auth.uid, empresaId), ownerUid, empresaId);
    }

    function isCompanyRole(role, perfil, roles) {
      return roles.hasAny([role]) || roles.hasAny([perfil]);
    }

    function hasCompanyRoleLink(linkPath, ownerUid, empresaId, roles) {
      let usuarioEmpresa = get(companyUserPath(
        ownerUid,
        empresaId,
        get(linkPath).data.usuarioEmpresaId
      )).data;

      return hasValidCompanyLink(linkPath, ownerUid, empresaId) &&
        isCompanyRole(usuarioEmpresa.role, usuarioEmpresa.perfil, roles);
    }

    function hasCompanyMemberRole(ownerUid, empresaId, roles) {
      return hasCompanyRoleLink(
        authCompanyPath(request.auth.uid, empresaId),
        ownerUid,
        empresaId,
        roles
      ) ||
        hasCompanyRoleLink(
          userCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId,
          roles
        );
    }

    function hasCompanyRole(ownerUid, empresaId, roles) {
      return isOwner(ownerUid) ||
        isAdminMaster() ||
        hasCompanyMemberRole(ownerUid, empresaId, roles);
    }

    function isCompanyAdministratorCanonical(ownerUid, empresaId) {
      return hasCompanyRole(ownerUid, empresaId, ["administrador_empresa"]);
    }

    function canReadModuleRole(role, perfil, modulo) {
      return canWriteModuleRole(role, perfil, modulo) ||
        (
          modulo == "dashboard" &&
          isCompanyRole(role, perfil, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ])
        ) ||
        (
          modulo == "relatorios" &&
          isCompanyRole(role, perfil, [
            "administrador_empresa",
            "financeiro",
            "comercial",
            "visualizacao"
          ])
        ) ||
        (
          isCompanyRole(role, perfil, ["visualizacao"]) &&
          [
            "insumos",
            "produtos",
            "producao",
            "vendas",
            "despesas",
            "perdasDoacoes",
            "clientesComerciais"
          ].hasAny([modulo])
        );
    }

    function canWriteModuleRole(role, perfil, modulo) {
      return isCompanyRole(role, perfil, ["administrador_empresa"]) ||
        (
          isCompanyRole(role, perfil, ["financeiro"]) &&
          [
            "despesas",
            "fornecedores"
          ].hasAny([modulo])
        ) ||
        (
          isCompanyRole(role, perfil, ["producao"]) &&
          [
            "insumos",
            "produtos",
            "producao",
            "estoque",
            "perdasDoacoes",
            "fornecedores"
          ].hasAny([modulo])
        ) ||
        (
          isCompanyRole(role, perfil, ["comercial"]) &&
          [
            "vendas",
            "clientesComerciais"
          ].hasAny([modulo])
        ) ||
        (
          isCompanyRole(role, perfil, ["estoque"]) &&
          [
            "insumos",
            "estoque",
            "perdasDoacoes"
          ].hasAny([modulo])
        );
    }

    function hasCompanyModulePermissionLink(linkPath, ownerUid, empresaId, modulo, escrita) {
      let usuarioEmpresa = get(companyUserPath(
        ownerUid,
        empresaId,
        get(linkPath).data.usuarioEmpresaId
      )).data;

      return hasValidCompanyLink(linkPath, ownerUid, empresaId) &&
        (
          (
            escrita == true &&
            canWriteModuleRole(usuarioEmpresa.role, usuarioEmpresa.perfil, modulo)
          ) ||
          (
            escrita == false &&
            canReadModuleRole(usuarioEmpresa.role, usuarioEmpresa.perfil, modulo)
          )
        );
    }

    function canReadModule(ownerUid, empresaId, modulo) {
      return isOwner(ownerUid) ||
        isAdminMaster() ||
        hasCompanyModulePermissionLink(
          authCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId,
          modulo,
          false
        ) ||
        hasCompanyModulePermissionLink(
          userCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId,
          modulo,
          false
        );
    }

    function canWriteModule(ownerUid, empresaId, modulo) {
      return isOwner(ownerUid) ||
        isAdminMaster() ||
        hasCompanyModulePermissionLink(
          authCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId,
          modulo,
          true
        ) ||
        hasCompanyModulePermissionLink(
          userCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId,
          modulo,
          true
        );
    }

    function canWriteCompanyConfiguration(ownerUid, empresaId, documentId) {
      return isCompanyAdministratorCanonical(ownerUid, empresaId) ||
        (
          documentId == "estoqueMinimo" &&
          canWriteModule(ownerUid, empresaId, "estoque")
        );
    }

    function isFornecedorRoleAllowed(role) {
      return role == "administrador_empresa" ||
        role == "Administrador da Empresa" ||
        role == "financeiro" ||
        role == "Financeiro" ||
        role == "producao" ||
        role == "Producao" ||
        role == "Produção";
    }

    function hasFornecedorRoleLink(linkPath, ownerUid, empresaId) {
      return hasValidCompanyLink(linkPath, ownerUid, empresaId) &&
        (
          isFornecedorRoleAllowed(get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.role) ||
          isFornecedorRoleAllowed(get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.perfil)
        );
    }

    function canManageFornecedores(ownerUid, empresaId) {
      return isOwner(ownerUid) ||
        hasFornecedorRoleLink(
          authCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId
        ) ||
        hasFornecedorRoleLink(
          userCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId
        );
    }

    function isPerdasDoacoesRoleAllowed(role) {
      return role == "administrador_empresa" ||
        role == "Administrador da Empresa" ||
        role == "producao" ||
        role == "Producao" ||
        role == "ProduÃ§Ã£o" ||
        role == "estoque" ||
        role == "Estoque";
    }

    function hasPerdasDoacoesRoleLink(linkPath, ownerUid, empresaId) {
      return hasValidCompanyLink(linkPath, ownerUid, empresaId) &&
        (
          isPerdasDoacoesRoleAllowed(get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.role) ||
          isPerdasDoacoesRoleAllowed(get(companyUserPath(
            ownerUid,
            empresaId,
            get(linkPath).data.usuarioEmpresaId
          )).data.perfil)
        );
    }

    function canManagePerdasDoacoes(ownerUid, empresaId) {
      return isOwner(ownerUid) ||
        isAdminMaster() ||
        hasPerdasDoacoesRoleLink(
          authCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId
        ) ||
        hasPerdasDoacoesRoleLink(
          userCompanyPath(request.auth.uid, empresaId),
          ownerUid,
          empresaId
        );
    }

    function hasCompanyAccess(ownerUid, empresaId) {
      return isOwner(ownerUid) || isAdminMaster() || hasActiveCompanyMembership(ownerUid, empresaId);
    }

    function isCompanyAdmin(ownerUid, empresaId) {
      return isOwner(ownerUid) || isAdminMaster() || hasCompanyAdminMembership(ownerUid, empresaId);
    }

    function isValidPendingInvite(token, ownerUid, empresaId) {
      return signedIn() &&
        token is string &&
        exists(invitePath(token)) &&
        get(invitePath(token)).data.status == "pendente" &&
        get(invitePath(token)).data.ownerUid == ownerUid &&
        get(invitePath(token)).data.empresaId == empresaId &&
        get(invitePath(token)).data.email == request.auth.token.email &&
        get(invitePath(token)).data.expiraEm is timestamp &&
        get(invitePath(token)).data.expiraEm > request.time;
    }

    function isValidPendingInviteForUsuarioEmpresa(token, ownerUid, empresaId, usuarioId) {
      return isValidPendingInvite(token, ownerUid, empresaId) &&
        get(invitePath(token)).data.token == token &&
        get(invitePath(token)).data.usuarioEmpresaId == usuarioId;
    }

    function isValidInviteForCompanyLink(token, ownerUid, empresaId) {
      return isValidPendingInvite(token, ownerUid, empresaId) ||
        (
          signedIn() &&
          token is string &&
          exists(invitePath(token)) &&
          get(invitePath(token)).data.status == "aceito" &&
          get(invitePath(token)).data.ownerUid == ownerUid &&
          get(invitePath(token)).data.empresaId == empresaId &&
          get(invitePath(token)).data.email == request.auth.token.email &&
          get(invitePath(token)).data.uidAuth == request.auth.uid
        );
    }

    function isCreatingInvitedCompanyPointer(userId, empresaId) {
      return isOwner(userId) &&
        request.resource.data.ownerUid is string &&
        request.resource.data.ownerUid != userId &&
        request.resource.data.conviteToken is string &&
        request.resource.data.status == "ativo" &&
        isValidInviteForCompanyLink(
          request.resource.data.conviteToken,
          request.resource.data.ownerUid,
          empresaId
        );
    }

    function isAcceptingUsuarioEmpresa(ownerUid, empresaId, usuarioId) {
      return signedIn() &&
        resource.data.status == "pendente" &&
        resource.data.email == request.auth.token.email &&
        resource.data.conviteToken is string &&
        isValidPendingInviteForUsuarioEmpresa(resource.data.conviteToken, ownerUid, empresaId, usuarioId) &&
        request.resource.data.uidAuth == request.auth.uid &&
        request.resource.data.status == "ativo" &&
        request.resource.data.convitePendente == false &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.dono == resource.data.dono;
    }

    function isCreatingInitialOwnerCompanyUser(ownerUid, usuarioId) {
      return isOwner(ownerUid) &&
        usuarioId == request.auth.uid &&
        request.resource.data.uidAuth == request.auth.uid &&
        request.resource.data.role == "administrador_empresa" &&
        request.resource.data.status == "ativo" &&
        request.resource.data.convitePendente == false &&
        request.resource.data.dono == true;
    }

    function isAcceptingConvite() {
      return signedIn() &&
        resource.data.status == "pendente" &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.usuarioEmpresaId == resource.data.usuarioEmpresaId &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.status == "aceito" &&
        request.resource.data.uidAuth == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "aceitoEm", "uidAuth", "atualizadoEm"]);
    }

    function isCreatingOwnUserProfile(userId) {
      return isOwner(userId) &&
        request.resource.data.role == "cliente";
    }

    function isUpdatingOwnUserProfile(userId) {
      return isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminMaster();
      allow create: if isCreatingOwnUserProfile(userId) || isAdminMaster();
      allow update: if isUpdatingOwnUserProfile(userId) || isAdminMaster();
      allow delete: if isAdminMaster();

      match /assinatura/{documentId} {
        allow read: if isOwner(userId) || isAdminMaster();
        allow write: if isAdminMaster();
      }

      match /empresas/{empresaId} {
        allow read: if hasCompanyAccess(userId, empresaId) || isOwner(userId) || isAdminMaster();
        allow create: if (
          isOwner(userId) &&
          (isOwnCompanyDocument(userId) || isCreatingInvitedCompanyPointer(userId, empresaId))
        ) || isAdminMaster();
        allow update: if isAdminMaster() ||
          (
            isOwner(userId) &&
            (
              (isExistingOwnCompanyDocument(userId) && isOwnCompanyDocument(userId)) ||
              isSafeCompanyPointerUpdate(userId)
            )
          );
        allow delete: if isOwner(userId) || isAdminMaster();

        match /usuariosEmpresa/{usuarioId} {
          function isValidCompanyUserRole(role) {
            return [
              "administrador_empresa",
              "financeiro",
              "producao",
              "comercial",
              "estoque",
              "visualizacao"
            ].hasAny([role]);
          }

          function isCreatingPendingCompanyInvite() {
            return isCompanyAdmin(userId, empresaId) &&
              request.resource.data.keys().hasOnly([
                "nome",
                "email",
                "role",
                "status",
                "uidAuth",
                "criadoEm",
                "atualizadoEm",
                "criadoPor",
                "convitePendente",
                "conviteToken",
                "conviteCriadoEm",
                "conviteExpiraEm",
                "conviteAceitoEm",
                "dono",
                "reconviteEm",
                "reconvitePor"
              ]) &&
              request.resource.data.status == "pendente" &&
              request.resource.data.convitePendente == true &&
              request.resource.data.uidAuth == null &&
              request.resource.data.dono == false &&
              request.resource.data.conviteToken is string &&
              request.resource.data.email is string &&
              request.resource.data.criadoPor == request.auth.uid &&
              isValidCompanyUserRole(request.resource.data.role);
          }

          function isCreatingInitialOwnerCompanyUserSafe() {
            return isCreatingInitialOwnerCompanyUser(userId, usuarioId) &&
              request.resource.data.keys().hasOnly([
                "nome",
                "email",
                "role",
                "status",
                "uidAuth",
                "atualizadoEm",
                "criadoPor",
                "convitePendente",
                "dono",
                "criadoEm"
              ]);
          }

          function isTargetCompanyUserManageable() {
            return resource.data.dono != true &&
              (
                !(resource.data.uidAuth is string) ||
                !exists(userPath(resource.data.uidAuth)) ||
                get(userPath(resource.data.uidAuth)).data.role != "admin_master"
              );
          }

          function isMaintainingOwnerCompanyUser() {
            return isOwner(userId) &&
              usuarioId == request.auth.uid &&
              resource.data.dono == true &&
              request.resource.data.dono == true &&
              request.resource.data.uidAuth == request.auth.uid &&
              request.resource.data.role == "administrador_empresa" &&
              request.resource.data.status == "ativo" &&
              request.resource.data.convitePendente == false &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "nome",
                "email",
                "role",
                "status",
                "uidAuth",
                "atualizadoEm",
                "criadoPor",
                "convitePendente",
                "dono",
                "criadoEm"
              ]);
          }

          function isUpdatingCompanyUserRole() {
            return isCompanyAdmin(userId, empresaId) &&
              isTargetCompanyUserManageable() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "role",
                "atualizadoEm"
              ]) &&
              isValidCompanyUserRole(request.resource.data.role);
          }

          function isUpdatingCompanyUserStatus() {
            return isCompanyAdmin(userId, empresaId) &&
              isTargetCompanyUserManageable() &&
              resource.data.uidAuth != request.auth.uid &&
              ["ativo", "inativo"].hasAny([resource.data.status]) &&
              ["ativo", "inativo"].hasAny([request.resource.data.status]) &&
              request.resource.data.convitePendente == false &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "status",
                "convitePendente",
                "atualizadoEm"
              ]);
          }

          function isRenewingPendingCompanyInvite() {
            return isCompanyAdmin(userId, empresaId) &&
              isTargetCompanyUserManageable() &&
              resource.data.status == "pendente" &&
              resource.data.uidAuth == null &&
              request.resource.data.status == "pendente" &&
              request.resource.data.convitePendente == true &&
              request.resource.data.conviteToken is string &&
              request.resource.data.conviteAceitoEm == null &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "conviteToken",
                "conviteCriadoEm",
                "conviteExpiraEm",
                "conviteAceitoEm",
                "convitePendente",
                "status",
                "atualizadoEm"
              ]);
          }

          function isReinvitingRemovedCompanyUser() {
            return isCompanyAdmin(userId, empresaId) &&
              isTargetCompanyUserManageable() &&
              resource.data.status == "removido" &&
              resource.data.uidAuth != request.auth.uid &&
              request.resource.data.status == "pendente" &&
              request.resource.data.convitePendente == true &&
              request.resource.data.uidAuth == null &&
              request.resource.data.dono == false &&
              request.resource.data.nome is string &&
              request.resource.data.email == resource.data.email &&
              request.resource.data.conviteToken is string &&
              request.resource.data.criadoEm is timestamp &&
              request.resource.data.atualizadoEm is timestamp &&
              request.resource.data.conviteCriadoEm is timestamp &&
              request.resource.data.conviteExpiraEm is timestamp &&
              request.resource.data.conviteExpiraEm > request.time &&
              request.resource.data.conviteAceitoEm == null &&
              request.resource.data.reconviteEm is timestamp &&
              request.resource.data.criadoEm == request.resource.data.conviteCriadoEm &&
              request.resource.data.atualizadoEm == request.resource.data.conviteCriadoEm &&
              request.resource.data.reconviteEm == request.resource.data.conviteCriadoEm &&
              request.resource.data.reconvitePor == request.auth.uid &&
              request.resource.data.criadoPor == request.auth.uid &&
              isValidCompanyUserRole(request.resource.data.role) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "nome",
                "role",
                "status",
                "uidAuth",
                "criadoEm",
                "atualizadoEm",
                "criadoPor",
                "convitePendente",
                "conviteToken",
                "conviteCriadoEm",
                "conviteExpiraEm",
                "conviteAceitoEm",
                "dono",
                "reconviteEm",
                "reconvitePor"
              ]);
          }

          function isAcceptingUsuarioEmpresaSafe() {
            return isAcceptingUsuarioEmpresa(userId, empresaId, usuarioId) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "uidAuth",
                "status",
                "convitePendente",
                "conviteAceitoEm",
                "vinculadoPorConvite",
                "atualizadoEm"
              ]);
          }

          allow read: if hasCompanyAccess(userId, empresaId);
          allow create: if isCreatingPendingCompanyInvite() ||
            isCreatingInitialOwnerCompanyUserSafe();
          allow update: if isMaintainingOwnerCompanyUser() ||
            isUpdatingCompanyUserRole() ||
            isUpdatingCompanyUserStatus() ||
            isRenewingPendingCompanyInvite() ||
            isReinvitingRemovedCompanyUser() ||
            isAcceptingUsuarioEmpresaSafe();
          allow delete: if false;
        }

        match /configuracoes/{documentId} {
          allow get: if ["empresa", "fiscal", "estoqueMinimoProdutos"].hasAny([documentId]) &&
            hasCompanyAccess(userId, empresaId);
          allow list: if hasCompanyAccess(userId, empresaId);
          allow create, update: if (
            documentId == "fiscal" && isCompanyAdmin(userId, empresaId)
          ) || (
            documentId == "estoqueMinimoProdutos" && canWriteModule(userId, empresaId, "estoque")
          ) || (
            documentId == "empresa" &&
            isCompanyAdministratorCanonical(userId, empresaId)
          );
          allow delete: if false;
        }

        match /parametros/{documentId} {
          allow read: if [
            "unidadesMedida",
            "tiposProduto",
            "categoriasDespesa"
          ].hasAny([documentId]) &&
            hasCompanyRole(userId, empresaId, [
              "administrador_empresa",
              "financeiro",
              "producao",
              "estoque"
            ]);
          allow create: if (
            documentId == "unidadesMedida" &&
            hasCompanyRole(userId, empresaId, [
              "administrador_empresa",
              "producao",
              "estoque"
            ])
          ) || (
            documentId == "tiposProduto" &&
            hasCompanyRole(userId, empresaId, [
              "administrador_empresa",
              "producao"
            ])
          ) || (
            documentId == "categoriasDespesa" &&
            hasCompanyRole(userId, empresaId, [
              "administrador_empresa",
              "financeiro"
            ])
          );
          allow update: if isCompanyAdministratorCanonical(userId, empresaId);
          allow delete: if false;
        }

        match /insumos/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ]);
          allow create, update, delete: if canWriteModule(userId, empresaId, "insumos");
        }

        match /produtos/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ]);
          allow create, update, delete: if canWriteModule(userId, empresaId, "produtos");
        }

        match /producoes/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ]);
          allow create, update, delete: if canWriteModule(userId, empresaId, "producao");
        }

        match /vendas/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ]);
          allow create, update: if canWriteModule(userId, empresaId, "vendas");
          allow delete: if false;
        }

        match /despesas/{documentId} {
          allow read: if canReadModule(userId, empresaId, "despesas");
          allow create, update: if canWriteModule(userId, empresaId, "despesas");
          allow delete: if false;
        }

        match /perdasDoacoes/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao",
            "comercial",
            "estoque",
            "visualizacao"
          ]);
          allow create, update: if canManagePerdasDoacoes(userId, empresaId);
          allow delete: if false;
        }

        match /fornecedores/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "financeiro",
            "producao"
          ]) || canManageFornecedores(userId, empresaId);
          allow create, update: if canWriteModule(userId, empresaId, "fornecedores") ||
            canManageFornecedores(userId, empresaId);
          allow delete: if false;
        }

        match /clientesComerciais/{documentId} {
          allow read: if hasCompanyRole(userId, empresaId, [
            "administrador_empresa",
            "comercial"
          ]);
          allow create, update: if canWriteModule(userId, empresaId, "clientesComerciais");
          allow delete: if false;
        }
      }
    }

    match /usuariosPorAuth/{uidAuth}/empresas/{empresaId} {
      allow read: if isOwner(uidAuth) || isAdminMaster();
      allow create: if isCreatingInvitedCompanyPointer(uidAuth, empresaId) || isAdminMaster();
      allow update: if isOwner(uidAuth) &&
        resource.data.ownerUid == request.resource.data.ownerUid &&
        resource.data.usuarioEmpresaId == request.resource.data.usuarioEmpresaId &&
        request.resource.data.status == "ativo";
      allow delete: if isAdminMaster();
    }

    match /convitesEmpresa/{token} {
      allow list: if false;
      allow get: if resource.data.status == "pendente" ||
        (
          signedIn() &&
          (
            resource.data.email == request.auth.token.email ||
            isCompanyAdmin(resource.data.ownerUid, resource.data.empresaId)
          )
        );
      allow create: if signedIn() &&
        request.resource.data.status == "pendente" &&
        request.resource.data.token == token &&
        isCompanyAdmin(request.resource.data.ownerUid, request.resource.data.empresaId);
      allow update: if isCompanyAdmin(resource.data.ownerUid, resource.data.empresaId) ||
        isAcceptingConvite();
      allow delete: if false;
    }

    match /logs/{document=**} {
      allow read, write: if isAdminMaster();
    }
  }
}
